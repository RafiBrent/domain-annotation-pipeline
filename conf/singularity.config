params.singularity_image_dir = '/SAN/orengolab/bfvd/singularity_images'
//params.scratch_dir = "/SAN/orengolab/bfvd/nextflow_scratch/${System.getenv('USER')}"
params.scratch_dir = false
params.project = params.project ?: 'cath'

// Default time limits (can be overridden via command line)
params.slurm_time_gpu = '8h'

// Exclude specific nodes from GPU jobs
// params.excluded_gpu_nodes = ['bubba-213-3.local']

executor {
    name = 'slurm'
    queueSize = 100
    // Enable SLURM array jobs for improved efficiency
    // When multiple tasks with the same resources are submitted,
    // Nextflow will automatically group them into array jobs
    submitRateLimit = '10 sec'  // Limit submission rate to avoid overwhelming scheduler
    queueStatInterval = '30 sec' // How often to check job status
}

// ========== PROCESS SETTINGS ==========
process {

    // ---------- LABEL PROFILES ----------

    // Local processes
    withLabel: local {
        executor = 'local'
    }

    // Generic SLURM CPU jobs
    withLabel: sge_low {
        scratch  = params.scratch_dir
        executor = 'slurm'
        time     = '1h'

        // Common SLURM options for non-GPU jobs
        clusterOptions = {
            def mem  = task.memory ? task.memory.mega : '7000'
            def opts = "--mem=${mem}M --exclude=c1127,c1306"
            return opts
        }
    }

    // Generic SLURM GPU jobs
    withLabel: sge_gpu_high {
        containerOptions = '--nv --env CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES'  // required for GPU support in containers
        scratch          = params.scratch_dir
        executor         = 'slurm'

        // Common SLURM options for GPU jobs
        clusterOptions = {
            def mem  = task.memory ? task.memory.mega : '31000'
            def time = task.time ? task.time.toString() : params.slurm_time_gpu
            def partition = params.slurm_queue_gpu ?: 'gpu'
            def gres = params.slurm_gres_gpu ?: 'gpu:1'
            // def opts = "--partition=${partition} --mem=${mem}M --gres=${gres} --time=${time.replace('h', ':00:00')} --exclude=g1001,g2701,g2702,g2703,g2704,g2705,g2706,g2707,g2708,g2113,g2155,g2118,g2119,g2120,g2541,g2126,g2127,g2128,g2129,g2130,g2131,g2132,g2133,g2134"
            def opts = "--partition=${partition} --mem=${mem}M --gres=${gres} --time=${time.replace('h', ':00:00')} --exclude=g1001,g2701,g2702,g2703,g2704,g2705,g2706,g2707,g2708,g2541,g2127,g2128,g2129,g2130,g2131,g2132,g2133,g2134"
            return opts
        }
    }

    // ---------- DEFAULT CONTAINERS ----------

    withName: '.*' {
        cache     = 'lenient'
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withName: 'foldseek.*' {
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-foldseek_latest.sif"
    }

    // ---------- PROCESS-SPECIFIC OVERRIDES ----------

    // SLURM CPU, big memory + retries
    withName: chop_pdb {
        array         = params.slurm_array_max_cpu
        memory        = '31GB'
        errorStrategy = 'retry'
        maxRetries    = 4
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
    }

    withName: chop_pdb_from_zip {
        array         = params.slurm_array_max_cpu
        memory        = '15GB'
        errorStrategy = 'retry'
        maxRetries    = 4
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
    }

    withName: chop_pdb_from_directory {
        array         = params.slurm_array_max_cpu
        memory        = '15GB'
        errorStrategy = 'retry'
        maxRetries    = 4
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
    }

    withName: get_uniprot_data {
        maxForks      = 2
        errorStrategy = 'retry'
        maxRetries    = 5
    }

    withName: run_plddt {
        array = params.slurm_array_max_cpu
    }

    withName: summarise_stride {
        executor = 'local'
    }

    withName: transform_consensus {
        executor = 'local'
    }

    withName: run_get_consensus {
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    }

    withName: run_filter_consensus {
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    }

    withName: extract_pdb_from_zip {
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    }

    withName: extract_pdb_from_directory {
        executor      = 'slurm'
        array         = params.slurm_array_max_cpu
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
        errorStrategy = 'retry'
        maxRetries    = 2
        memory        = '4GB'
    }

    withName: run_filter_domains {
        executor = 'local'
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    }

    // SLURM CPU, 15G memory, retries
    withName: run_stride {
        executor      = 'slurm'
        array         = params.slurm_array_max_cpu
        memory        = '15GB'
        time          = '12h'
        errorStrategy = 'retry'
        maxRetries    = 2
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-cath-af-cli_latest.sif"
    }

    withName: run_AF_domain_id {
        executor = 'local'
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-cath-af-cli_latest.sif"
    }

    withName: create_md5 {
        executor  = 'slurm'
        array     = params.slurm_array_max_cpu
        container = "${params.singularity_image_dir}/domain-annotation-pipeline-cath-af-cli_latest.sif"
    }

    withName: run_measure_globularity {
        executor      = 'slurm'
        array         = params.slurm_array_max_cpu
        memory        = '15GB'
        time          = '12h'
        errorStrategy = 'retry'
        maxRetries    = 2
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-cath-af-cli_latest.sif"
    }

    withName: filter_pdb {
        executor      = 'slurm'
        array         = params.slurm_array_max_cpu
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-script_latest.sif"
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = '4GB'
    }

    // GPU + dynamic memory based on attempt
    withName: run_ted_segmentation {
        executor      = 'slurm'
        array         = params.slurm_array_max_gpu
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
        errorStrategy = 'retry'
        maxRetries    = 6

        // 1st attempt: 7 GB, 2nd: 15 GB, 3rd: 31 GB
        // memory = { task.attempt == 1 ? 7.GB : task.attempt == 2 ? 15.GB : 31.GB }
        memory = { task.attempt == 1 ? 31.GB : task.attempt == 2 ? 47.GB : 63.GB }
    }

    withName: run_domain_quality {
        executor      = 'slurm'
        array         = params.slurm_array_max_gpu
        container     = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = '31GB'
        time          = { "${Math.max(1, (params.slurm_time_gpu.replace('h','') as int).intdiv(4))}h" }
    }

    // Unused process configurations (processes don't exist in workflow)
    // withName: run_domain_quality_from_zip {
    //     executor      = 'slurm'
    //     container     = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    //     errorStrategy = 'retry'
    //     maxRetries    = 3
    //     memory        = '31GB'
    // }

    // withName: files_from_zip {
    //     container = "${params.singularity_image_dir}/domain-annotation-pipeline-ted-tools_latest.sif"
    // }
}

// ========== SINGULARITY SETTINGS ==========
singularity {
    enabled      = true
    autoMounts   = true
    mode         = "native"
    envWhitelist = 'CUDA_VISIBLE_DEVICES,SINGULARITYENV_CUDA_VISIBLE_DEVICES'
    // make the launch directory available inside the container as read-only
    runOptions = "--bind ${launchDir}:/launchDir:ro --bind /software:/software:ro --bind /net:/net:ro"
}
